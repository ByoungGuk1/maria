<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.app.maria.domain.customer.mapper.CustomerMapper">

    <select id="selectActiveRiaCustomers" resultType="CustomerCiHashDTO">
        SELECT c.customer_id, c.ci_hash
        FROM customer c
        JOIN account a ON a.customer_id = c.customer_id
        WHERE a.status = 'OPENED'
    </select>

</mapper>
